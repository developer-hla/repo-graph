# Copy this file to .env for local Docker runs.
# Never commit .env. The repo .gitignore excludes .env and .env.*.

# Optional GitHub token for private org discovery and HTTPS clone/fetch.
# Use a fine-grained token with the minimum repository read access needed.
GITHUB_TOKEN=

# Optional host ports for Docker Compose.
REPO_GRAPH_NEO4J_HTTP_PORT=7475
REPO_GRAPH_NEO4J_BOLT_PORT=7688
